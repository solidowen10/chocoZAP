# ---- Core ----
NODE_ENV=production
PORT=3000
APP_URL=https://tracker.yourdomain.com
SESSION_SECRET=replace-with-a-long-random-string

# ---- LINE Login (for user sign-in) ----
# Create a "LINE Login" channel at https://developers.line.biz/console/
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=https://tracker.yourdomain.com/auth/line/callback

# ---- LINE Messaging API (for push notifications) ----
# This is a SEPARATE channel from LINE Login ("Messaging API" channel type).
# Each recipient must add this channel's official account as a friend once
# before they can receive push messages.
LINE_MESSAGING_ACCESS_TOKEN=

# ---- Scheduling ----
SCHEDULE_TZ=Asia/Taipei
ENABLE_CRON=1

# ---- Database ----
# Defaults to ./data/app.db if unset
DB_PATH=
