# ---- Core ----
NODE_ENV=production
PORT=3100
APP_URL=https://gym.selinnaowen.com
SESSION_SECRET=replace-with-a-long-random-string

# ---- LINE Login ----
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=https://gym.selinnaowen.com/auth/line/callback

# ---- LINE Messaging API ----
LINE_MESSAGING_ACCESS_TOKEN=

# ---- Scheduling ----
SCHEDULE_TZ=Asia/Taipei
ENABLE_CRON=1

# ---- Database ----
DB_PATH=/opt/site-ledger/data/app.db

# ---- Property Radar / Google Sheet staging ----
LOCATION_SYNC_TOKEN=
PROPERTY_SOURCING_SHEET_ID=1gPuUmnP8LqfUwFC6QFi5pBjL5BO9ZDTnAwvJG2QjlIg
PROPERTY_SOURCING_SHEET_TAB=自動蒐集
# Optional full published CSV URL. If set, this wins over ID/TAB.
PROPERTY_SOURCING_SHEET_CSV_URL=
