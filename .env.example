# ---- Core ----
NODE_ENV=production
PORT=3100
APP_URL=https://gym.luruee.com
SESSION_SECRET=replace-with-a-long-random-string

# ---- LINE Login ----
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=https://gym.luruee.com/auth/line/callback

# ---- LINE Messaging API ----
LINE_MESSAGING_ACCESS_TOKEN=

# ---- Scheduling ----
SCHEDULE_TZ=Asia/Taipei
ENABLE_CRON=1

# ---- Database ----
DB_PATH=/opt/site-ledger/data/app.db

# ---- Property Radar / Google Sheet staging ----
LOCATION_SYNC_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/opt/site-ledger/credentials/google-sheets-service-account.json
MANUAL_RESEARCH_SHEET_ID=1gPuUmnP8LqfUwFC6QFi5pBjL5BO9ZDTnAwvJG2QjlIg
PROPERTY_SOURCING_SHEET_ID=1gPuUmnP8LqfUwFC6QFi5pBjL5BO9ZDTnAwvJG2QjlIg
