const fs = require('fs');

const FILE = './data/location-report.json';
const report = JSON.parse(fs.readFileSync(FILE, 'utf8'));

function num(v) {
  if (v == null) return null;
  const n = parseFloat(String(v).replace(/[^\d.-]/g, ''));
  return Number.isFinite(n) ? n : null;
}

function walkMinutes(v='') {
  const m = String(v).match(/(\d+)/);
  return m ? Number(m[1]) : null;
}

function scoreLocation(x) {
  let score = 5;
  const risks = [];
  const missing = [];

  const ping = x.areaPing ?? num(x.area);
  const walk = walkMinutes(x.mrt);
  const floor = String(x.floor || '');
  const broker = String(x.brokerAnswer || '');
  const toshi = String(x.toshiScore || '');
  const nakamura = String(x.nakamuraScore || '');

  // 面積
  if (x.region === '台北') {
    if (ping >= 80 && ping <= 160) score += 1.5;
    else if (ping >= 70 && ping < 80) score += 0.5;
    else {
      score -= 1;
      risks.push('台北旗艦目標 80–160 坪，面積不理想');
    }
  } else if (ping >= 70) {
    score += 0.5;
  }

  // 交通
  if (walk != null) {
    if (walk <= 5) score += 1;
    else if (walk <= 10) score += 0.5;
    else {
      score -= 0.5;
      risks.push('步行距離偏遠');
    }
  } else {
    missing.push('步行時間');
  }

  // 樓層
  if (/1F\+2F|1F \+ 2F/.test(floor)) score += 1;
  if (/B1/.test(floor)) score -= 0.25;

  // 明確淘汰訊號
  if (/老朽|古い|老舊/.test(broker + toshi + nakamura)) {
    score = Math.min(score, 4);
    risks.push('建物老舊');
  }

  if (/SPA|スパ|内装|內裝|解体|拆除/.test(broker + toshi)) {
    score -= 1;
    risks.push('既有內裝／拆除成本風險');
  }

  if (/耐荷重|跳|揺|晃/.test(broker + toshi)) {
    score = Math.min(score, 4);
    risks.push('樓板／跳躍風險');
  }

  if (/賃貸は不可|ジム.*不可|フィットネスジム業態への賃貸は不可/.test(broker)) {
    score = 0;
    risks.push('房東不接受健身房業態');
  }

  // 看板
  if (/NG|不可|できません/.test(String(x.signage || '') + broker)) {
    score -= 1;
    risks.push('看板受限');
  } else if (!x.signage) {
    missing.push('看板');
  }

  // 使用分區 / D1 D5
  if (!/D1|D5|商業|住居|住宅|使用用途|用途地域/.test(broker)) {
    missing.push('使用分區 / D1 D5');
  }

  if (ping > 90.75) {
    missing.push('確認 D1');
  } else if (ping != null) {
    missing.push('確認 D5');
  }

  // 2F jump test
  if (/2F/.test(floor)) {
    missing.push('2F 跳躍測試');
  }

  score = Math.max(0, Math.min(10, Math.round(score * 2) / 2));

  let status = '補資料';
  if (score >= 8) status = '推薦看屋';
  if (score <= 4) status = '淘汰';

  const next =
    status === '推薦看屋'
      ? '安排現勘，優先確認樓板、用途與看板'
      : status === '淘汰'
      ? '不優先，除非關鍵條件有重大改善'
      : '先向房仲補齊缺資料再決定是否排看屋';

  return {
    score,
    status,
    risks: [...new Set(risks)],
    missing: [...new Set(missing)],
    next
  };
}

let count = 0;

for (const x of report.locations) {
  if (!['台北','新北'].includes(x.region)) continue;

  const r = scoreLocation(x);

  x.aiScore = r.score;
  x.aiReviewer = 'chocoZAP Taiwan Assistant (AI)';
  x.aiReviewedAt = new Date().toISOString();

  x.status = r.status;
  x.risk = r.risks.length ? r.risks.join('；') : '目前無明確重大風險';
  x.missing = r.missing.length ? r.missing.join('、') : '無';
  x.next = r.next;

  x.aiComment =
    `依目前 Sheet、房仲回覆、坪數、樓層與交通資料初評。` +
    `目前 AI Score ${r.score}/10。` +
    `附近競品與商圈人流尚待外部研究完成後再更新。`;

  x.competition = x.competitionOriginal
    ? `Sheet 原始競合距離：${x.competitionOriginal}；待 Agent 補充附近健身房名稱與密度`
    : '待 Agent 研究附近健身房';

  x.trafficResearch = '待 Agent 進行商圈／人流研究';

  count++;
}

report.updatedAt = new Date().toISOString();
report.updatedBy = 'chocoZAP Taiwan Assistant (AI)';

fs.writeFileSync(FILE, JSON.stringify(report, null, 2));

console.log(`enriched ${count} Taipei/New Taipei locations`);
